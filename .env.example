# Copy to .env.local for local development (never commit .env.local / .env.production).
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time:
# never put a secret in one.

# Backend API base URL (the NestJS backend, including the /api/v1 prefix)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Google Sign-In OAuth client ID (public by design; the client SECRET is never used here)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# Public origin of this deployment, used for canonical / og:url links
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "staging" on the staging copy: no indexing + a visible environment banner. Unset = production.
# NEXT_PUBLIC_APP_ENV=development

# Optional CDN / custom domain in front of the public media bucket (default https://storage.googleapis.com)
# NEXT_PUBLIC_ASSET_BASE=https://storage.googleapis.com

# Extra hosts the site may redirect to for payment (comma-separated), on top of the
# built-in ICICI / own-backend allowlist in lib/safe-redirect.ts
# NEXT_PUBLIC_PAYMENT_REDIRECT_HOSTS=

# Google Search Console verification code (production only)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
